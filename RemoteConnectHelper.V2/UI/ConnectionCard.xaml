<Window x:Class="RemoteConnectHelper.V2.UI.ConnectionCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="../Assets/app.ico" Title="灰Desk" Width="320" Height="500" WindowStyle="None" ResizeMode="CanResize" MinHeight="420" MinWidth="320" ShowInTaskbar="True"
 ShowActivated="False" Topmost="True" AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI"
 PreviewKeyDown="Card_KeyDown" PreviewMouseDown="Card_MouseDown" Closing="Card_Closing" AllowDrop="True" Drop="Card_Drop">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,5"/><Setter Property="Background" Value="{DynamicResource ThemeWhite}"/><Setter Property="Foreground" Value="{DynamicResource Theme33445F}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeDCE3EF}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="{DynamicResource ThemeF1F5FC}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeD6E0EF}"/><Setter Property="Foreground" Value="{DynamicResource Theme213351}"/></Style>
  <Style x:Key="AppTab" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Theme748197}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Plate" Background="Transparent" CornerRadius="6" Padding="10,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource ThemeWhite}"/><Setter Property="Foreground" Value="{DynamicResource Theme315FD5}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ConnectionActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource ThemeE8EBEF}"/><Setter Property="Foreground" Value="{DynamicResource Theme364358}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionPlate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionPlate" Property="Background" Value="{DynamicResource ThemeDFE3E9}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionPlate" Property="Background" Value="{DynamicResource ThemeD3D9E2}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionPlate" Property="Background" Value="{DynamicResource ThemeF0F2F5}"/><Setter Property="Foreground" Value="{DynamicResource Theme94A0B1}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PreviewActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="26"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="6,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Tag" Value="Selected"><Setter Property="Background" Value="{DynamicResource ThemeEAF1FF}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme5486E5}"/><Setter Property="Foreground" Value="{DynamicResource Theme2863D4}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
 <Grid x:Name="WindowVisual">
 <Border x:Name="ShellBackground" BorderBrush="{DynamicResource ThemeD5DFEF}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource ThemeFCFDFF}"/>
 <Border x:Name="EditorBackground" Width="320" HorizontalAlignment="Right" BorderBrush="{DynamicResource ThemeD5DFEF}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource ThemeFCFDFF}" Visibility="Collapsed"/>
 <Border Padding="19,15">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="BodyGrid" Grid.Row="0" Grid.RowSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="0"/></Style></ScrollViewer.Resources>
   <StackPanel Margin="0,0,3,0">
  <Grid x:Name="HeaderBar" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_Down" MouseMove="Header_Move" MouseLeftButtonUp="Header_Up" LostMouseCapture="Header_LostCapture" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image Width="36" Height="36" Source="../Assets/app_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True" Margin="0,0,10,0"/>
   <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="灰Desk" FontWeight="Bold" Foreground="{DynamicResource Theme243651}" FontSize="17"/><TextBlock x:Name="WindowSizeText" Visibility="Collapsed" FontSize="9" Foreground="{DynamicResource Theme8B97A9}" Margin="7,0,0,1" VerticalAlignment="Bottom" ToolTip="主界面当前整体宽×高（屏幕像素）；展开预览时包含预览与核对区"/></StackPanel><TextBlock x:Name="SubtitleText" Text="离线识别 · 安静连接" Foreground="{DynamicResource Theme8B97A9}" FontSize="10"/></StackPanel>
   <StackPanel x:Name="WindowButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
    <Button x:Name="MinimizeButton" Content="−" Click="Minimize_Click" Width="25" Padding="0,3" BorderThickness="0" Background="Transparent" ToolTip="最小化到任务栏"/>
    <Button x:Name="MaximizeButton" Content="□" Click="Maximize_Click" Width="25" Padding="0,3" BorderThickness="0" Background="Transparent" ToolTip="最大化 / 还原"/>
    <Button x:Name="HideButton" Content="×" Click="Hide_Click" Width="25" Padding="0,3" BorderThickness="0" Background="Transparent" ToolTip="收回托盘；不会断开已有会话"/>
   </StackPanel>
  </Grid>

    <TextBlock x:Name="ConnectionStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme65758F}" Margin="0,0,0,10"/>
    <TextBlock x:Name="CompactStatus" Visibility="Collapsed"/>
    <ComboBox x:Name="AppBox" Visibility="Collapsed" SelectionChanged="App_Changed"><ComboBoxItem/><ComboBoxItem Content="向日葵"/><ComboBoxItem Content="ToDesk"/></ComboBox>
    <Grid x:Name="SoftwareStatusRow"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
    <TextBlock Text="远程软件" FontSize="11" Foreground="{DynamicResource Theme65758F}" Margin="0,2,0,7"/>
    <Button x:Name="SoftwarePickerButton" Width="180" Height="34" HorizontalAlignment="Left" Margin="0,0,0,12" Click="SoftwarePicker_Click" KeyboardNavigation.TabIndex="3" Background="{DynamicResource ThemeWhite}" BorderBrush="{DynamicResource ThemeD6E0EF}">
      <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5"><ContentPresenter/></Border></ControlTemplate></Button.Template>
      <Grid Width="158"><TextBlock x:Name="SoftwareName" Text="向日葵" FontSize="12" Foreground="{DynamicResource Theme33445F}" VerticalAlignment="Center"/><TextBlock Text="⌄" FontSize="13" Foreground="{DynamicResource Theme78869D}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </Button>
    </StackPanel>
    <Border x:Name="RiskBox" Visibility="Collapsed" Grid.Column="1" CornerRadius="7" Background="{DynamicResource ThemeEEF3FC}" Padding="9" Margin="12,0,0,12"><StackPanel><TextBlock x:Name="TitleText" Text="等待截图" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme3D5E91}"/><TextBlock x:Name="RiskText" TextWrapping="Wrap" Foreground="{DynamicResource Theme65758F}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
    </Grid>

    <TextBlock Text="设备码" FontSize="11" Foreground="{DynamicResource Theme65758F}" Margin="0,2,0,7"/>
    <Grid Width="272" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBox x:Name="CodeBox" Width="180" HorizontalAlignment="Left" Height="38" FontSize="18" FontFamily="Consolas" InputMethod.IsInputMethodEnabled="False" TextChanged="Input_Changed" KeyboardNavigation.TabIndex="0" ToolTip="设备码"/>
      <Button x:Name="CodeCandidateButton" Grid.Column="1" Content="候选" Click="CodeCandidates_Click" Margin="8,0,0,0" Padding="6,3" FontSize="11" Visibility="Collapsed"/>
    </Grid>
    <Expander x:Name="CandidatesPanel" Header="其他设备码候选" FontSize="11" Foreground="{DynamicResource Theme7D8BA2}" Margin="0,4,0,0" Visibility="Collapsed"><WrapPanel x:Name="CodeOptions" Margin="0,4,0,0"/></Expander>
    <TextBlock Text="验证码 / 密码" FontSize="11" Foreground="{DynamicResource Theme65758F}" Margin="0,12,0,7"/>
    <Grid Width="272" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBox x:Name="PasswordBox" Width="180" HorizontalAlignment="Left" Height="38" FontSize="18" FontFamily="Consolas" InputMethod.IsInputMethodEnabled="False" TextChanged="Input_Changed" KeyboardNavigation.TabIndex="1"/>
      <Button x:Name="PasswordCandidateButton" Grid.Column="1" Content="候选" Click="PasswordCandidates_Click" Margin="8,0,0,0" Padding="6,3" FontSize="11" Visibility="Collapsed"/>
    </Grid>
    <TextBlock x:Name="PasswordState" Visibility="Collapsed" Foreground="{DynamicResource Theme94A0B2}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
    <Expander x:Name="PasswordCandidatesPanel" Visibility="Collapsed" Header="其他验证码候选" FontSize="11" Foreground="{DynamicResource Theme7D8BA2}" Margin="0,5,0,0"><WrapPanel x:Name="PasswordOptions" Margin="0,4,0,0"/></Expander>

    <TextBlock x:Name="EntryHint" Foreground="{DynamicResource Theme8B98AC}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <Grid x:Name="ConnectionActions" Width="272" HorizontalAlignment="Left" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="RecognizeButton" Style="{StaticResource ConnectionActionStyle}" Click="Recognize_Click" Height="36" Margin="0,0,4,0" KeyboardNavigation.TabIndex="5"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="识别" VerticalAlignment="Center"/><Viewbox x:Name="RecognitionRings" Width="16" Height="14" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="24" Height="20"><Path Stroke="{DynamicResource Theme4F5D71}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,10 C7,2 17,2 22,10 C17,18 7,18 2,10 Z"/><Ellipse Width="6" Height="6" Canvas.Left="9" Canvas.Top="7" Stroke="{DynamicResource Theme4F5D71}" StrokeThickness="1.7"/></Canvas></Viewbox></StackPanel></Button>
     <Button x:Name="ConnectButton" Style="{StaticResource ConnectionActionStyle}" Grid.Column="1" Margin="4,0,0,0" Content="连接 ↵" Click="Connect_Click" FontSize="13" FontWeight="SemiBold" Height="36" KeyboardNavigation.TabIndex="2">

     </Button>
     <Button x:Name="StopButton" Grid.Column="2" Content="停止" Click="Stop_Click" Margin="6,0,0,0"/>
    </Grid>
    <WrapPanel Margin="0,12,0,0"><Button x:Name="OriginalButton" Click="Original_Click" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Path x:Name="PreviewArrow" Width="8" Height="8" Stretch="Uniform" Data="M0,0 L6,4 L0,8 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5" Margin="0,0,5,0"><Path.RenderTransform><RotateTransform x:Name="PreviewArrowRotation"/></Path.RenderTransform></Path><TextBlock x:Name="PreviewToggleText" Text="打开预览" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ReadButton" Visibility="Collapsed" Content="重新读取" Click="Read_Click" Margin="0,0,6,0"/><Button x:Name="OpenButton" Content="打开图片" Click="Open_Click"/><Button x:Name="ManualButton" Visibility="Collapsed" Content="手动填写" Click="Manual_Click"/></WrapPanel>
    <Border BorderBrush="{DynamicResource ThemeE6EAF0}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0"><StackPanel>
      <DockPanel><Button DockPanel.Dock="Right" Content="清除记录" Click="ClearRecent_Click" BorderThickness="0" Padding="0" Background="Transparent" FontSize="10"/><TextBlock x:Name="HistoryHeading" ToolTip="记录本次运行识别到的设备码，最多6条，两行显示最匹配的6条；不保存密码" Text="连接历史" Foreground="{DynamicResource Theme33445F}" FontSize="11"/></DockPanel>
      <UniformGrid x:Name="RecentOptions" Columns="3" Rows="2" Margin="0,8,0,0"/>
      <TextBlock x:Name="NoRecent" Text="暂无连接历史" FontSize="10" Foreground="{DynamicResource Theme94A0B2}" Margin="0,6,0,0"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Grid x:Name="ImagePanel" Grid.Column="1" Width="430" Margin="18,0,0,0" Visibility="Collapsed"><Grid x:Name="PreviewVisual"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel x:Name="ImageToolbar" Height="36" Cursor="SizeAll" Background="{DynamicResource ThemeWhite}" MouseLeftButtonDown="Header_Down" MouseMove="Header_Move" MouseLeftButtonUp="Header_Up" LostMouseCapture="Header_LostCapture" Margin="0" LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
       <Button x:Name="FullImageButton" Style="{StaticResource PreviewActionStyle}" Content="全图" Click="FullImage_Click" Width="48"/>
       <Button x:Name="FocusFieldsButton" Style="{StaticResource PreviewActionStyle}" Content="定位号码" Click="FocusFields_Click" Width="64" Margin="6,0,0,0"/>
       <Button x:Name="PreviewCloseButton" Style="{StaticResource PreviewActionStyle}" Content="清空预览" Click="PreviewClose_Click" Width="72" Margin="6,0,0,0" ToolTip="清除当前预览内容，保留预览区和已填信息"/>
      </StackPanel>
      <TextBlock x:Name="PreviewHeading" TextTrimming="CharacterEllipsis" Text="界面分辨率" ToolTip="图片区正常缩放、拖动和右键选号码；顶部和底栏只移动预览区，四边靠近核对区可吸附" FontSize="11" Foreground="{DynamicResource Theme71829C}" VerticalAlignment="Center"/>
    </DockPanel>
    <Grid x:Name="PreviewArea" Grid.Row="1" Background="{DynamicResource ThemeEDF2FA}" ClipToBounds="True" Cursor="Hand" SizeChanged="Preview_Changed" MouseWheel="Preview_Wheel" MouseLeftButtonDown="Preview_Down" MouseMove="Preview_Move" MouseLeftButtonUp="Preview_Up" LostMouseCapture="Preview_LostCapture">
     <Grid x:Name="ImageViewport" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageZoom" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ImagePan"/></TransformGroup></Grid.RenderTransform><Image x:Name="SourceImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Canvas x:Name="Overlay" IsHitTestVisible="True" ClipToBounds="True"/></Grid>
     <TextBlock x:Name="NoImage" Text="复制图片或文字以预览" IsHitTestVisible="False" Foreground="{DynamicResource Theme91A0B6}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
    </Grid>
    <Border x:Name="PreviewFooter" Grid.Row="2" Height="28" Background="{DynamicResource ThemeWhite}" BorderBrush="{DynamicResource ThemeE6EBF2}" BorderThickness="0,1,0,0" Padding="10,0"
      MouseLeftButtonDown="Header_Down" MouseMove="Header_Move" MouseLeftButtonUp="Header_Up" LostMouseCapture="Header_LostCapture" Cursor="SizeAll">
     <TextBlock x:Name="PreviewEngineText" Text="文字识别：PP-OCRv5 · RapidOCR" FontSize="10.5" Foreground="{DynamicResource Theme7B8798}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="PP-OCRv5（PaddleOCR）· RapidOCR；方向检测：PP-LCNet"/>
    </Border>

   </Grid></Grid>
  </Grid>

 </Grid></Border>
 </Grid>

 </Grid>
</Window>
