<Window x:Class="RemoteConnectHelper.V2.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="二代远程助手" Width="1060" Height="780" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#273451"/>
            <Setter Property="BorderBrush" Value="#D7DFED"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFD"/><Setter Property="Foreground" Value="#172741"/>
            <Setter Property="BorderBrush" Value="#CAD5E5"/><Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="26,20,26,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" Background="#E2ECFF" CornerRadius="14" Margin="0,0,13,0">
                    <Image Source="../Assets/app_glyph.png" Margin="7"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="远程助手" FontSize="24" FontWeight="SemiBold" Foreground="#14243D"/>
                        <Border Background="#E1EAFE" CornerRadius="5" Margin="10,6,0,3" Padding="8,2">
                            <TextBlock Text="第二代" Foreground="#315FD1" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="读截图，连设备。识别不准时直接修改。" Foreground="#75839B" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Content="悬浮球" Click="Ball_Click"/>
                <Button Content="日志" Click="Logs_Click" Margin="0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ReadButton" Content="读取截图" Background="#3565DF" Foreground="White" BorderThickness="0" Click="Read_Click"/>
                    <Button x:Name="OpenButton" Content="打开图片…" Click="Open_Click"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <CheckBox x:Name="AutoCheck" Content="识别后自动连接" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0" Click="Preferences_Click"/>
                    <CheckBox x:Name="WatchCheck" Content="自动读取新截图" VerticalAlignment="Center" Click="Preferences_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="原图" FontWeight="SemiBold" Foreground="#273451" VerticalAlignment="Center"/>
                        <Button Content="放大查看" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Preview_Click" Padding="10,4" FontSize="11" Margin="0"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#EAF0F8" CornerRadius="8" ClipToBounds="True">
                        <Grid x:Name="PreviewArea" SizeChanged="Preview_SizeChanged">
                            <Image x:Name="SourceImage" Stretch="Uniform"/>
                            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True"/>
                            <StackPanel x:Name="EmptyImage" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="把客户发来的远程截图复制到剪贴板" Foreground="#65768F" FontSize="14" TextAlignment="Center"/>
                                <TextBlock Text="再点「读取截图」，或把图片拖到这里" Foreground="#8B98AC" FontSize="12" Margin="0,9,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="蓝框是设备码，橙框是密码。原图保持完整。" Foreground="#8592A8" FontSize="11" Margin="0,11,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="290" HorizontalAlignment="Left">
                        <TextBlock Text="连接信息" FontSize="16" FontWeight="SemiBold" Foreground="#20304C" Margin="0,0,0,16"/>
                        <TextBlock Text="远程软件" Foreground="#718198" FontSize="12" Margin="0,0,0,7"/>
                        <ComboBox x:Name="AppBox" Height="38" FontSize="14" SelectionChanged="AppBox_SelectionChanged">
                            <ComboBoxItem Content="请选择软件" Tag="Unknown"/>
                            <ComboBoxItem Content="向日葵" Tag="Sunlogin"/>
                            <ComboBoxItem Content="ToDesk" Tag="ToDesk"/>
                        </ComboBox>
                        <TextBlock Text="设备码" Foreground="#718198" FontSize="12" Margin="0,18,0,7"/>
                        <TextBox x:Name="CodeBox" FontSize="24" FontFamily="Consolas" InputMethod.IsInputMethodEnabled="False" TextChanged="Input_TextChanged"/>
                        <WrapPanel x:Name="CodeCandidates" Margin="0,7,0,0"/>
                        <TextBlock Text="密码 / 验证码" Foreground="#718198" FontSize="12" Margin="0,17,0,7"/>
                        <TextBox x:Name="PasswordBox" FontSize="20" FontFamily="Consolas" InputMethod.IsInputMethodEnabled="False" TextChanged="Input_TextChanged"/>
                        <TextBlock Text="没有密码可留空，需要时再补填" Foreground="#8D99AC" FontSize="11" Margin="0,5,0,0"/>
                        <WrapPanel x:Name="PasswordCandidates" Margin="0,7,0,0"/>
                        <Border Background="#EDF3FF" CornerRadius="8" Padding="12" Margin="0,18,0,16">
                            <StackPanel>
                                <TextBlock x:Name="StatusTitle" Text="等待截图" Foreground="#315FD1" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatusText" Text="识别完成后会在这里显示连接信息" TextWrapping="Wrap" Foreground="#657998" FontSize="12" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Expander Header="识别详情" Foreground="#7C8BA2" FontSize="11" Margin="0,18,0,0">
                            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" BorderThickness="0" Background="Transparent" MinHeight="50"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="StopButton" Content="停止" Click="Stop_Click" Margin="0"/>
                    <Button x:Name="ConnectButton" Grid.Column="2" Content="连接" Click="Connect_Click" Background="#3565DF" Foreground="White" BorderThickness="0" Margin="0"/>
                </Grid>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,13,0,0">
            <TextBlock x:Name="FooterText" Text="本地离线识别 · Ctrl+Alt+R 读取截图 · Esc 停止" Foreground="#8290A6" FontSize="11"/>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#98A3B5" FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
