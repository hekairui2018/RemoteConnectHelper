<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RemoteConnectHelper</AssemblyName>
    <RootNamespace>RemoteConnectHelper</RootNamespace>
    <Version>1.0.0</Version>
    <Product>远程连接助手</Product>
    <AssemblyTitle>远程连接助手</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same ico embedded for the tray NotifyIcon (ApplicationIcon only sets the exe/Win32 icon) -->
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Circular Big-Dipper logos used inside WPF windows -->
    <Resource Include="Assets\app_logo.png" />
    <Resource Include="Assets\app_glyph.png" />
  </ItemGroup>

</Project>
