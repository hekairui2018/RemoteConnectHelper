<Window x:Class="RemoteConnectHelper.UI.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" Width="84" Height="84"
        FontFamily="Microsoft YaHei UI">
    <Grid Background="Transparent" MouseRightButtonUp="Grid_MouseRightButtonUp">

        <Image x:Name="Ball" Width="80" Height="80" Cursor="Hand" Stretch="Uniform"
               Source="pack://application:,,,/Assets/app_logo.png"
               RenderOptions.BitmapScalingMode="HighQuality"
               ToolTipService.ToolTip="点一下：连接刚截的远程码（截图时已提前识别，点一下秒连；也可按 Ctrl+Alt+R）&#10;按住可拖动，右键出菜单"
               MouseLeftButtonDown="Ball_MouseLeftButtonDown"
               MouseMove="Ball_MouseMove"
               MouseLeftButtonUp="Ball_MouseLeftButtonUp"/>
    </Grid>
</Window>
