<Window x:Class="RemoteConnectHelper.UI.StatusHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        Width="400" Height="112"
        Background="Transparent" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6EC"/>
            <Setter Property="Background" Value="#2E2E3A"/>
            <Setter Property="BorderBrush" Value="#454554"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A4A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="12" Background="#1E1E26"
            BorderBrush="#3D3D4A" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#4C8DFF"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="正在连接…" Foreground="#F2F2F6"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="CodeText" Text="" Foreground="#FFFFFF" FontSize="17"
                           FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="SubText" Text="" Foreground="#9A9AA6" FontSize="11"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
            </StackPanel>

            <StackPanel x:Name="BtnPanel" Grid.Column="1" VerticalAlignment="Center"
                        HorizontalAlignment="Right" MinWidth="78">
                <Button x:Name="BtnCancel" Content="取消连接" Click="BtnCancel_Click"/>
                <Button x:Name="BtnRetry" Content="重试" Click="BtnRetry_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnManual" Content="手动改/输密码" Click="BtnManual_Click"
                        Visibility="Collapsed" Width="96"/>
                <Button x:Name="BtnClose" Content="关闭" Click="BtnClose_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
