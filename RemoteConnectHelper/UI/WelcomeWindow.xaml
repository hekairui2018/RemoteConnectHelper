<Window x:Class="RemoteConnectHelper.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Width="492" SizeToContent="Height"
        Background="Transparent" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9AA6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33333F"/>
                                <Setter Property="Foreground" Value="#F2F2F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4C8DFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5E9AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="14" Background="#1E1E26"
            BorderBrush="#3D3D4A" BorderThickness="1" Padding="22,18,22,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏（可拖动） -->
            <Grid x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/app_glyph.png" Width="30" Height="30"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="远程连接助手" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="把截图给它，点一下就自动连向日葵 / ToDesk" Foreground="#9A9AA6" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="BtnX" Style="{StaticResource GhostBtn}" Content="✕" Width="28" Height="28"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <!-- 三步 -->
            <StackPanel Margin="2,16,2,0">
                <Grid Margin="0,0,0,12">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#2E3A55" VerticalAlignment="Top">
                        <TextBlock Text="1" Foreground="#7FB0FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="34,0,0,0">
                        <TextBlock Text="让客户的远程码显示在屏幕上" Foreground="#F2F2F6" FontSize="13"/>
                        <TextBlock Text="客户发来的软件截图、或微信/企微里的账号密码图片都行。"
                                   Foreground="#9A9AA6" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Border Width="24" Height="24" CornerRadius="12" Background="#2E3A55" VerticalAlignment="Top">
                        <TextBlock Text="2" Foreground="#7FB0FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="34,0,0,0">
                        <TextBlock Text="按 Win + Shift + S，鼠标框住那串设备码 / 密码，松手" Foreground="#F2F2F6" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="框选的截图会自动复制，不用粘贴、也不用保存文件。&#10;（聊天图片也可以直接在图片上右键 → 复制）"
                                   Foreground="#9A9AA6" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Border Width="24" Height="24" CornerRadius="12" Background="#2E3A55" VerticalAlignment="Top">
                        <TextBlock Text="3" Foreground="#7FB0FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="34,0,0,0">
                        <TextBlock Text="截好后点一下北斗悬浮球（或按 Ctrl + Alt + R），立即连接" Foreground="#F2F2F6" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="截图的同时它已在后台提前识别并记住，点一下就秒连、不用等；普通截图不会被记住，右下角弹小条时可取消，不会连错人。" Foreground="#9A9AA6" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="想完全不用点？右键悬浮球勾选 " Foreground="#9A9AA6" FontSize="11" VerticalAlignment="Center"/>
                            <Border Background="#26262F" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="截图后自动连接" Foreground="#7FB0FF" FontSize="11"/>
                            </Border>
                            <TextBlock Text=" 即认出就自动连。" Foreground="#9A9AA6" FontSize="11" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Background="#26262F" CornerRadius="8" Padding="11,9" Margin="2,14,2,0">
                <StackPanel>
                    <TextBlock Text="· 截图里没有密码 = 免密直连。" Foreground="#B8B8C4" FontSize="11"/>
                    <TextBlock Text="· 认不准 / 没写是哪个软件时，会弹卡片让你核对再连，不会连错人。" Foreground="#B8B8C4" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="· 程序常驻右下角托盘；Win11 点「^」能看到图标，可拖到任务栏，右键图标有菜单。" Foreground="#B8B8C4" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 选项 -->
            <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（推荐，客服机日常常驻）"
                      Foreground="#C9C9D4" FontSize="12" Margin="4,14,0,0"/>
            <CheckBox x:Name="ChkDontShow" Content="以后不再自动弹出本说明（可在托盘右键「使用说明」随时打开）"
                      Foreground="#C9C9D4" FontSize="12" Margin="4,7,0,0"/>

            <Button x:Name="BtnOk" Style="{StaticResource PrimaryBtn}" Content="知道了，开始用"
                    HorizontalAlignment="Stretch" Height="38" Margin="2,16,2,0" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
